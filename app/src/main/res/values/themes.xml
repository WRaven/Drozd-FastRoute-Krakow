<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <bool name="fast_route_light_system_bars">true</bool>

    <style name="Theme.FastRoute.Base" parent="@android:style/Theme.Material.Light.NoActionBar" />

    <style name="Theme.FastRoute" parent="Theme.FastRoute.Base">
        <item name="android:colorBackground">@color/fast_route_window_background</item>
        <item name="android:windowBackground">@color/fast_route_window_background</item>
        <item name="android:statusBarColor">@color/fast_route_window_background</item>
        <item name="android:navigationBarColor">@color/fast_route_window_background</item>
        <item name="android:windowLightStatusBar">@bool/fast_route_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/fast_route_light_system_bars</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/fast_route_window_background</item>
    </style>
</resources>
